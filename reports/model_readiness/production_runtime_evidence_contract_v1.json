{
  "adapter_version": "production_runtime_adapter_v1",
  "contract_id": "PRODUCTION_RUNTIME_EVIDENCE_CONTRACT_V1",
  "evidence_schema_version": "production_runtime_evidence_v1",
  "fail_closed": "unknown fields, missing required fields, invalid types, non-finite values, unit-invalid ranges, future-or-same temporal context, and mismatched asset capabilities raise validation errors or return explicit unavailable",
  "float_fidelity_tolerance": {
    "absolute": 1e-12,
    "relative": 0.0
  },
  "mappings": [
